<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting. `dotnet publish` generates a web.config of its own when the
  project has none; this file exists so the two things a first deployment
  always needs are in it rather than added by hand on the server afterwards.
  The SDK rewrites the %LAUNCHER_PATH% and %LAUNCHER_ARGS% tokens below to
  the published executable on the way out, and leaves everything else alone.

  See docs/DEPLOY_IIS.md for the whole sequence.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel="inprocess": the application runs inside the IIS worker
        process, so the port comes from the IIS site binding and the Kestrel
        section of appsettings.Production.json is ignored. Bind the site to
        6051 to leave the Cloudflare tunnel config untouched.

        stdoutLogEnabled is false because these logs are never rotated and
        grow without limit. Turn it on for exactly as long as it takes to
        read a startup failure, then turn it off again — docs/DEPLOY_IIS.md
        says where the file lands and what the alternative is.
      -->
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <!--
            Set here rather than machine-wide. It gates three things: the
            placeholder-JWT-key check, the OpenAPI endpoint, and whether the
            application migrates the database at startup (it must not, on a
            server — migrating is a release step of its own). A system
            environment variable would work too, and is one more thing to
            have been forgotten when a service fails to start.
          -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
