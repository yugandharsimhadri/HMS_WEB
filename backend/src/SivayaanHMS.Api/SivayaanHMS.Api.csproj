<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SivayaanHMS.Data\SivayaanHMS.Data.csproj" />
    <ProjectReference Include="..\SivayaanHMS.Printing\SivayaanHMS.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      appsettings.Local.json is a developer's own file: the database password and
      the platform-support password live in it, and .gitignore keeps it out of
      the repository.

      The Web SDK's default glob is appsettings*.json, so without this it was
      copied into `dotnet publish` output and shipped with the build - both
      passwords, and database settings pointing at a developer's own server.
      Because Program.cs loads it *last*, it would then have overridden
      appsettings.Production.json on the server: production would have quietly
      tried to reach a database that does not exist there, with the correct
      settings sitting in a file that never won.

      Still copied to the build output, so `dotnet run` picks it up as before.
    -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
