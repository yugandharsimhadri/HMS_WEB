{
  "//": "TEMPLATE. Copy to appsettings.Production.json IN THE PUBLISHED FOLDER ON THE SERVER, fill in the two secrets, and do not commit the result. This file ships as a template on purpose; the filled-in copy is git-ignored.",

  "Kestrel": {
    "//": "Port 6051, and localhost on purpose. The Cloudflare tunnel runs on this same machine and reaches the API over loopback, so binding to 0.0.0.0 would expose the API to the whole LAN for no benefit - anyone on the clinic wifi could skip the tunnel entirely. Override with ASPNETCORE_URLS if the tunnel is ever moved to another host.",
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:6051"
      }
    }
  },

  "Database": {
    "//": [
      "PostgreSQL. The only place the application learns where its database is, so a move to a",
      "cloud-hosted server is these few lines and a restart. Full reference: docs/POSTGRESQL_SETUP.md.",
      "Host     - localhost for PostgreSQL on this machine; for a managed server, its hostname,",
      "           e.g. mydb.abc123.ap-south-1.rds.amazonaws.com",
      "Port     - 5432 unless the server says otherwise.",
      "Name     - the database, lower-case, as created by docs/POSTGRESQL_SETUP.md.",
      "Username - the application role that OWNS the database (same document). Never postgres.",
      "Password - that role's password. Change it here and restart the service.",
      "SslMode  - Prefer on this machine. Require for any server that is not on this machine:",
      "           cloud providers insist on it, and traffic across a network without it is readable.",
      "MigrateOnStartup is deliberately absent: outside Development the default is off, and the",
      "release step deploy\\Migrate-Database.ps1 applies migrations with a backup taken first."
    ],
    "Host": "localhost",
    "Port": 5432,
    "Name": "sivayaanhms",
    "Username": "sivayaanhms",
    "Password": "REPLACE-ME",
    "SslMode": "Prefer",
    "MaxPoolSize": 50,
    "CommandTimeoutSeconds": 60,
    "ConnectionTimeoutSeconds": 60,
    "ApplicationName": "SivayaanHMS"
  },

  "WhatsApp": {
    "//": [
      "Welcome messages and password-reset codes. Leave AccessToken or PhoneNumberId empty and the",
      "application writes them to its log instead of sending - it says so at startup. Full guide:",
      "docs/WHATSAPP_SETUP.md.",
      "AccessToken        - the PERMANENT system-user token, not the 24-hour one the dashboard shows first.",
      "PhoneNumberId      - from WhatsApp > API Setup. A long number, not the phone number.",
      "DefaultCountryCode - prepended to a bare national number. Empty means never guess, and refuse instead.",
      "LanguageCode       - must match the approved template exactly; en and en_US are different templates."
    ],
    "AccessToken": "",
    "PhoneNumberId": "",
    "WelcomeTemplate": "hms_welcome",
    "ResetCodeTemplate": "hms_password_reset",
    "LanguageCode": "en",
    "DefaultCountryCode": "91"
  },

  "Jwt": {
    "//": "At least 32 bytes, and nothing like the development placeholder - Program.cs refuses to start outside Development if REPLACE-BEFORE-PRODUCTION is still in it. Anyone holding this can mint a token for any clinic.",
    "Key": "REPLACE-ME-with-at-least-32-bytes-of-random-text",
    "Issuer": "SivayaanHMS",
    "Audience": "SivayaanHMS",
    "ExpiryMinutes": 480
  },

  "Cors": {
    "//": "The Cloudflare Pages origin, and any custom domain. Not a wildcard: a bearer-token API allowing any origin would let any page on the internet read a signed-in clinic's data through a visitor's browser. Preview branches get their own hostnames and are not covered unless listed. Scheme and no trailing slash - https://healthone... matches, healthone... and https://healthone.../ do not.",
    "AllowedOrigins": [
      "https://healthone.sivayaantechnologies.com",
      "https://healthone-hms.pages.dev"
    ]
  },

  "PlatformAdmin": {
    "//": "Optional. Omit the block entirely and EnterpriseAdmin simply cannot sign in, which is the right failure for a credential nobody set.",
    "Username": "EnterpriseAdmin",
    "Password": "REPLACE-ME"
  }
}
