# Baked into the bundle at build time by Vite — this is not read at runtime,
# so changing it means rebuilding and redeploying.
#
# Committed because it is not a secret: it is the public hostname of the API,
# visible in every network request the app makes. Keeping it here means a
# production build is correct by default rather than depending on somebody
# remembering a dashboard setting.
#
# Cloudflare Pages' own environment variable of the same name overrides this
# if one is set, which is the escape hatch for a staging build.
VITE_API_URL=https://hoapi.sivayaantechnologies.com
