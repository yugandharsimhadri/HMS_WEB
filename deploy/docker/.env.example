# Copy to deploy/docker/.env and fill in. That file is git-ignored; this one
# is the committed template. docs/DEPLOY_DOCKER.md explains each value.
#
#   cp deploy/docker/.env.example deploy/docker/.env

# ── Database ─────────────────────────────────────────────────────────────
# One Npgsql connection string; it replaces every individual Database key.
#
# Host is the Linux VM running PostgreSQL - an IP or a resolvable name, NOT
# localhost: inside a container localhost is the container itself. Use
# host.docker.internal if PostgreSQL is on the machine running Docker.
#
# SSL Mode: Prefer is acceptable only on a private virtual network between
# the two machines. Anything crossing a real network wants Require, and the
# VM then needs ssl=on with a certificate (docs/DEPLOY_DOCKER.md section 2).
Database__ConnectionString=Host=192.168.1.50;Port=5432;Database=sivayaanhms;Username=healthone_app;Password=CHANGE_ME;SSL Mode=Prefer;Command Timeout=60;Application Name=SivayaanHMS

# ── Secrets ──────────────────────────────────────────────────────────────
# Signs every session token. At least 32 bytes, and changing it signs
# everyone out. Keep the one the existing server uses to avoid that:
#   openssl rand -base64 48
Jwt__Key=CHANGE_ME_48_RANDOM_BYTES_BASE64

# Cross-clinic support login. The API refuses to start outside Development
# without a password here.
PlatformAdmin__Username=EnterpriseAdmin
PlatformAdmin__Password=CHANGE_ME

# ── Frontend origins ─────────────────────────────────────────────────────
# The frontend stays on Cloudflare Pages, so it is a different origin and
# CORS still applies. One variable per entry, zero-indexed. Scheme, no
# trailing slash, lower case - matching is exact.
Cors__AllowedOrigins__0=https://healthone.sivayaantechnologies.com
Cors__AllowedOrigins__1=https://healthone-hms.pages.dev

# ── Host-specific ────────────────────────────────────────────────────────
# Clinic timezone. The schema stores wall-clock time with no offset, and a
# container defaults to UTC.
TZ=Asia/Kolkata

# The Docker bridge subnet, so the tunnel's X-Forwarded-Proto is trusted.
# 172.16.0.0/12 covers Docker's defaults; check with
#   docker network inspect bridge --format '{{(index .IPAM.Config 0).Subnet}}'
DOCKER_BRIDGE_CIDR=172.16.0.0/12

# Image tag, if you want to pin a release rather than overwrite :latest.
TAG=latest
